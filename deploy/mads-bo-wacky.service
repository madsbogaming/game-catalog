# The bot as a Linux service: starts at boot, and again 30 seconds after it stops for any reason.
# Installed by deploy/setup.sh. Logs: journalctl -u mads-bo-wacky -f
[Unit]
Description=Mads-bo-wacky Get on the Game bot
Wants=network-online.target
After=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/mads-bo-wacky
ExecStart=/opt/mads-bo-wacky/.venv/bin/python bot.py
Environment=PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
