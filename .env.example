# Copy this file to .env and fill in your values.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID (right-click the server icon -> Copy Server ID). Makes slash commands appear instantly.
GUILD_ID=

# Comma-separated channel IDs to watch for links. Leave empty to watch every channel the bot can see.
WATCH_CHANNEL_IDS=

# Two-letter country code for Steam prices (us, dk, gb, de, ...)
STEAM_COUNTRY=us

# Reaction friends click to say "I want to play this"
INTEREST_EMOJI=🎮

DB_PATH=catalog.db

# Port for the catalog web page, and whether to open a public Cloudflare tunnel to it (needed for /catalog in Discord)
WEB_PORT=8765
PUBLIC_TUNNEL=true
# A fixed public address that already points at WEB_PORT (e.g. Tailscale Funnel). Replaces the Cloudflare tunnel,
# so the Activity URL mapping only has to be set once.
PUBLIC_URL=

# OAuth2 client secret (Developer Portal > OAuth2 > Reset Secret). Lets people mark games from /catalog.
DISCORD_CLIENT_SECRET=

# Discord user IDs (comma separated) who may use every command; everyone else only gets /catalog, /random and /link. Empty = mods.
ADMIN_IDS=

# Channel for free-to-keep Steam games (default: the first watched channel). 0 turns it off.
FREE_GAMES_CHANNEL_ID=

# Steam Web API key (https://steamcommunity.com/dev/apikey). Optional: ratings then show each person's Steam hours,
# for people who linked Steam to Discord and have public game details.
STEAM_API_KEY=

# Weekly post of catalog games on deep discount. Channel (default: the free-games channel; 0 turns it off),
# day (0 = Monday ... 6 = Sunday), hour (local time) and the smallest discount in percent.
DEALS_CHANNEL_ID=
DEALS_DAY=3
DEALS_HOUR=19
DEALS_MIN_DISCOUNT=70

# Other channels or threads the bot may read besides the watched ones (e.g. a feedback thread). It ignores
# messages everywhere else, even if Discord lets it see them.
READ_CHANNEL_IDS=

# Discord thread that tools/new_feedback.py reads for new feedback (optional)
FEEDBACK_THREAD_ID=

# Folder for the nightly catalog.db backups made by tools/backup_db.py (default: "Mads-bo-wacky backups" in OneDrive)
BACKUP_DIR=
